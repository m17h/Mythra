{
  "name": "mythra",
  "version": "0.9.1",
  "author": "Mythra",
  "description": "Mythra — a retro-lit AI coding desktop app for local LM Studio models and OpenRouter.",
  "productName": "Mythra",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons:mac": "bash scripts/generate-mac-icns.sh",
    "patch:mac-app": "bash scripts/patch-mac-app-icons.sh",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.mythra.app",
    "productName": "Mythra",
    "copyright": "Copyright © Mythra",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "asar": false,
    "afterPack": "./scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "m17h",
        "repo": "Mythra-Releases"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "Images/app_icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSMinimumSystemVersion": "12.0",
        "NSHighResolutionCapable": true
      }
    },
    "win": {
      "icon": "build/app_icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/app_icon.ico",
      "uninstallerIcon": "build/app_icon.ico"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@napi-rs/canvas": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.23.24",
    "jszip": "^3.10.1",
    "openai": "^6.3.0",
    "pdfjs-dist": "^5.7.284",
    "pino": "^10.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "dompurify": "^3.4.7"
  }
}
